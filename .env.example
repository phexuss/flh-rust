# Freelancehunt API
FREELANCEHUNT_API_TOKEN=your_freelancehunt_api_token_here
FREELANCEHUNT_SESSION_COOKIE=your_phpsessid_or_cookie_string

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# AI Provider ("gemini", "groq", or "openrouter")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash

# Bot Configuration
PARSE_INTERVAL_MINUTES=7
TARGET_SKILL_IDS=1,2,86,88,96,99,166
LANGUAGE=uk

# Database & Logs
DB_PATH=data/bot.db
LOG_PATH=logs/bot.log
